<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive OS app -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <!-- Features commonly absent on AAOS head units -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Location (LocationManager on the emulator) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Pleos NaviHelper: get*Info() -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- AAOS CarPropertyManager: IGNITION_STATE -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!--
        Parked-only app: intentionally NO distractionOptimized meta-data.
        The UI is hidden while CarUxRestrictions require distraction optimization.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChagokChagok">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
