<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive OS app -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <!-- Features commonly absent on AAOS head units -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Location (LocationManager on the emulator) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Pleos NaviHelper: requestRoute() needs NAVI_ROUTE_SEARCH; route events and getRecentDestinationInfo()
         need NAVI_ROUTE (see navi/). -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- Lets the app check that a navigation app exists before offering "내비 켜기" (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
    </queries>

    <!-- AAOS car properties (gear / ignition), for parked detection -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!--
        Parked-only app. The activity is declared distraction optimized so that our own static notice
        ("주행 중에는 사용할 수 없어요") is shown instead of the system blocking screen. While
        CarUxRestrictions require distraction optimization the app shows only that notice, accepts no
        input, reads no location and stamps nothing (see car/CarStateMonitor.kt, ui/DrivingBlockScreen.kt).
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChagokChagok">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
